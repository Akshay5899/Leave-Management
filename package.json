{
  "name": "employee-leave-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0 --port 5173 --strictPort\" \"npm run server:watch\"",
    "client": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "server": "node server.js",
    "server:watch": "nodemon --watch server.js --ext js --exec \"node server.js\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "vite": "^6.0.7"
  }
}
